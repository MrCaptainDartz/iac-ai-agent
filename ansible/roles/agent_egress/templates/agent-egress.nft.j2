# Agent zone egress filtering (Ansible Managed) — loaded by agent-egress.service, never nftables.service (whose stock config flushes UFW).

# `destroy` first: re-applying is atomic and idempotent, with no unfiltered window.
destroy table inet agent_egress

table inet agent_egress {
  chain output {
    # priority -50: before UFW's OUTPUT (priority 0); a base-chain drop is terminal.
    type filter hook output priority -50; policy accept;

    # No name resolution: the loopback stub forwards upstream under its own uid.
    meta skuid { {{ agent_egress_uids }} } ip daddr 127.0.0.0/8 udp dport 53 counter drop
    meta skuid { {{ agent_egress_uids }} } ip daddr 127.0.0.0/8 tcp dport 53 counter drop
    meta skuid { {{ agent_egress_uids }} } ip6 daddr ::1 udp dport 53 counter drop
    meta skuid { {{ agent_egress_uids }} } ip6 daddr ::1 tcp dport 53 counter drop
{% if agent_egress_blocked_loopback_ports | length > 0 %}

    # Doors the agent zone may not take: the host's sshd, the provider's own port.
{% for port in agent_egress_blocked_loopback_ports %}
{% if port | int > 0 %}
    meta skuid { {{ agent_egress_uids }} } ip daddr 127.0.0.0/8 tcp dport {{ port }} counter drop
    meta skuid { {{ agent_egress_uids }} } ip daddr 127.0.0.0/8 udp dport {{ port }} counter drop
    meta skuid { {{ agent_egress_uids }} } ip6 daddr ::1 tcp dport {{ port }} counter drop
    meta skuid { {{ agent_egress_uids }} } ip6 daddr ::1 udp dport {{ port }} counter drop
{% endif %}
{% endfor %}
{% endif %}

    # Loopback only. Subuid ranges cover --network=host containers; others exit as the harness uid.
    meta skuid { {{ agent_egress_uids }} } ip daddr != 127.0.0.0/8 \
      limit rate {{ agent_egress_log_rate }} burst {{ agent_egress_log_burst }} packets \
      log prefix "{{ agent_egress_log_prefix }}"
    meta skuid { {{ agent_egress_uids }} } ip daddr != 127.0.0.0/8 counter drop
    meta skuid { {{ agent_egress_uids }} } ip6 daddr != ::1 counter drop
  }
}
