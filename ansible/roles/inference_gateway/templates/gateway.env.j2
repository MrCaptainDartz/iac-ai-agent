# Inference gateway environment (Ansible Managed)
# Secrets live here, never in config.yaml.
DISABLE_ADMIN_UI=True
{% if inference_gateway_debug_logging | default(false) %}
# litellm's detailed debug stream, prompts included: hundreds of journal lines per request.
DETAILED_DEBUG=True
{% endif %}
{% for model in inference_gateway_models %}
{% if model.api_key is defined %}
INFERENCE_GATEWAY_KEY_{{ loop.index }}={{ model.api_key }}
{% endif %}
{% endfor %}
