# Security Audit Rules (Ansible Managed)

# Monitor user/group modifications
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity

# Monitor sudoers configuration
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers

# Monitor SSH configuration and keys
-w /etc/ssh/sshd_config -p wa -k sshd_config
-w /etc/ssh/sshd_config.d/ -p wa -k sshd_config

# Monitor PAM and login configuration
-w /etc/pam.d/ -p wa -k pam
-w /etc/login.defs -p wa -k login_defs
-w /etc/security/pwquality.conf -p wa -k pwquality

# Monitor system startup/service definitions
-w /etc/systemd/ -p wa -k systemd

# Monitor network configuration & hostname
-w /etc/hosts -p wa -k network_config
-w /etc/hostname -p wa -k network_config

# Monitor cron scheduled tasks
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron

# Monitor system environment and shell profiles
-w /etc/environment -p wa -k environment
-w /etc/profile -p wa -k profile
-w /etc/profile.d/ -p wa -k profile
-w /etc/bash.bashrc -p wa -k shell_config

# Monitor package manager configuration
-w /etc/apt/sources.list -p wa -k apt
-w /etc/apt/sources.list.d/ -p wa -k apt
