# SSH Server Security Hardening (Ansible Managed)

# Access Control (Restricted to allowed users only)
AllowUsers {{ security_hardening_ssh_allowed_users | join(' ') }}
PermitRootLogin {{ security_hardening_ssh_permit_root_login }}

# Authentication Enforcement
AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication {{ security_hardening_ssh_password_authentication }}
PermitEmptyPasswords no
KbdInteractiveAuthentication no
GSSAPIAuthentication no
PermitUserEnvironment no
MaxAuthTries 4
MaxSessions 4
LoginGraceTime 30
MaxStartups 10:30:60

# Channel and Forwarding Restrictions
AllowAgentForwarding no
AllowTcpForwarding {{ security_hardening_ssh_allow_tcp_forwarding }}
PermitTunnel no
X11Forwarding no

# Logging, DNS and Keepalive
LogLevel VERBOSE
UseDNS no
TCPKeepAlive no
ClientAliveInterval {{ security_hardening_ssh_client_alive_interval }}
ClientAliveCountMax {{ security_hardening_ssh_client_alive_count_max }}

# Modern & Post-Quantum Cryptography (KEX, Ciphers, MACs)
KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com
