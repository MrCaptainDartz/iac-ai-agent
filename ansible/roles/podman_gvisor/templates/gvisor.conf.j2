# Podman runtime configuration for gVisor (runsc)
[engine]
runtime = "{{ 'runsc' if (podman_gvisor_default | default(true)) else 'crun' }}"
compose_warning_logs = false

[engine.runtimes]
runsc = [
    "{{ podman_gvisor_wrapper }}"
]
{% if podman_gvisor_netns | default('') | length > 0 %}
[containers]
netns = "{{ podman_gvisor_netns }}"
{% endif %}
