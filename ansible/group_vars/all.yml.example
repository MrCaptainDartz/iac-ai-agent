---
# Global variables for the project
# Copy this file to 'all.yml' and customize it according to your needs.

# Harness / Agent configuration
harness_name: "hermes" # e.g. "hermes", "openclaw", "smolagents" (lowercase alphanumeric + hyphens)

# Optional additional SSH public keys for the harness user
harness_ssh_keys: []

# SSH Security Configuration
ssh_allow_tcp_forwarding: false # Set to true if SSH port forwarding/tunneling is needed

# Container runtime & gVisor configuration
gvisor_enabled: true
gvisor_default: true # When true, gVisor (runsc) is used as the default OCI runtime for all containers

# Give every container gVisor's host stack instead of its netstack (default: false).
# Required for `--network=host` under rootless Podman unless passed per container (`--runtime-flag network=host`).
podman_gvisor_hostinet: false

# Default network mode for EVERY container, in Podman's vocabulary ("" leaves it to Podman).
# Not required if the harness container itself is launched with `--network=host`.
podman_gvisor_netns: ""

# Egress control: filter the agent zone's outbound traffic by uid — loopback only,
# name resolution included. Set to false to leave the outbound path unrestricted.
agent_egress_filter_enabled: true

# Node.js / NVM configuration
nvm_version: "v0.40.6"
nvm_node_version: "lts/*" # e.g. "lts/*", "22", "20"

# Python / uv configuration
uv_python_version: "3.14" # Python version managed by uv (e.g. "3.14", "3.13", "3.12")

# System configuration
system_timezone_value: "Europe/Paris"

# Additional custom system packages to install (e.g. ["zsh", "fish"])
essential_packages_extra: []

# Ollama configuration
# Set to false if you already have an external inference server and only want the agent environment
ollama_enabled: true

# Set to true if you pull models that need interactive OAuth authentication
ollama_signin_required: false

# Models to pull automatically.
# Default: a small local model + an embedding model — nothing leaves the VM.
# Remote models are a deployment choice, declare them here:
#   - <remote-model>:cloud   # requires ollama_signin_required: true
ollama_models:
  - qwen3:4b
  - qwen3-embedding:0.6b

# Trust zone: the system user that runs components holding a secret (the gateway today, the
# brokers later). It never executes code produced by the model.
trust_zone_enabled: true
broker_name: "broker"

# Inference gateway: the agent asks for a role alias, never for a provider model, so its own
# configuration does not change when the provider does. The alias table is REQUIRED.
inference_gateway_enabled: true
inference_gateway_port: 4000
inference_gateway_upstream_url: "http://127.0.0.1:11434" # local provider; its port is closed to the agent zone

# Alias the agent sees -> real provider model. Prefix picks the endpoint: ollama_chat/ for chat
# (tool calling), ollama/ for embeddings. api_base applies to local models only.
inference_gateway_models:
  - alias: reasoning
    model: "ollama_chat/qwen3:4b"
  - alias: embedding
    model: "ollama/qwen3-embedding:0.6b"
#   - alias: reasoning
#     model: "deepseek/deepseek-v4"
#     api_key: "<key>"

# litellm's detailed debug stream — prompts included, hundreds of journal lines per request.
# It is a debugging aid, not an audit trail: Phase 7 owns the real log sink.
inference_gateway_debug_logging: false

# L7 egress proxy (the adaptation brick): the agent zone's only way out, under a declared
# allowlist. Off by default — the socle gives the agent no web egress at all.
agent_egress_proxy_enabled: false
agent_egress_proxy_port: 8080

# [.]host[:port][/path] — a leading dot covers subdomains, no port means 80 and 443.
# Entries combine, and a path prefix needs TLS interception (level 2).
agent_egress_proxy_allowlist:
  - example.com
  - .githubusercontent.com
#   - "*"                     # any public host on 80 and 443 (add "*:8443" for another port):
#                             # gives up the per-destination control and resolves every name
#   - api.example.com/v1/     # level 2 only: paths are invisible without interception

# Level 2: TLS interception with an internal CA. Buys path rules and per-request visibility;
# costs that CA in every client stack (system, Python/Node, harness) and breaks cert pinning.
agent_egress_proxy_tls_intercept: false

# Kubernetes broker (read-only): the agent zone reaches a cluster through a loopback endpoint held by. the trust zone, so the token never enters the agent zone.
k8s_broker_enabled: false
k8s_broker_port: 8001

# The ServiceAccount kubeconfig: kept out of the repository, so it is a file and not a variable.
k8s_broker_kubeconfig_src: "{{ inventory_dir }}/../files/k8s-broker.kubeconfig"
