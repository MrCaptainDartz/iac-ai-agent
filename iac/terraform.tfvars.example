# Example file for sensitive data and configuration variables.
# Copy this file to 'terraform.tfvars' and fill in your values.

# ----------------------------------------------------------------
# Proxmox API (mandatory)
# ----------------------------------------------------------------
proxmox_api_url   = "https://10.x.x.x:8006/api2/json"
proxmox_api_token = "root@pam!opentofu=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Set to false if you have a valid TLS certificate on Proxmox
proxmox_insecure = true

# SSH user to access Proxmox nodes (default: root)
# proxmox_ssh_username = "root"

# ----------------------------------------------------------------
# SSH Access (mandatory)
# ----------------------------------------------------------------
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc... myuser@myworkstation"

# ----------------------------------------------------------------
# VM Configuration
# All VM settings (node, resources, network, GPU passthrough)
# are configured directly inside each VM object.
# Only node_name and network_interfaces are mandatory.
# ----------------------------------------------------------------
# vm_config = {
#   "vm-ai" = {
#     node_name = "pve-node1"
#
#     # Network configuration (mandatory)
#     network_interfaces = [
#       {
#         bridge  = "vmbr0"
#         address = "10.0.0.1/24"
#         gateway = "10.0.0.254"
#         vlan_id = 100
#       }
#     ]
#
#     # Optional VM settings (defaults shown below)
#     # vm_id             = null                  # Proxmox auto-assigns next free ID
#     # description       = "Managed by OpenTofu - AI Agent Host"
#     # cpu_cores         = 8
#     # cpu_type          = "x86-64-v2-AES"       # or "host"
#     # memory_mb         = 8192                  # 8 GiB
#     # disk_size_gb      = 120
#     # disk_datastore_id = "local-lvm"
#     # disk_ssd          = true                  # Enable SSD emulation
#     # disk_iothread     = false                 # Enable dedicated IOThread for performance
#     # disk_discard      = "on"                  # TRIM support
#     # machine_type      = "q35"                 # "q35" (PCIe/UEFI) or "pc"
#     # bios              = "ovmf"                # "ovmf" (UEFI) or "seabios"
#     # vga_type          = "qxl"                 # "qxl" (SPICE), "std", "serial0", "none"
#     # keyboard_layout   = "fr"                  # "fr", "en-us", etc.
#     # start_on_boot     = true
#     # tags              = ["ai-agent", "opentofu"]
#
#     # Optional PCI devices (GPU / accelerator passthrough)
#     # pci_devices = [
#     #   {
#     #     # Option A: Proxmox cluster resource mapping (recommended)
#     #     mapping = "gpu"
#     #
#     #     # Option B: Direct PCI ID (omit the .X suffix to passthrough all functions, e.g. "0000:01:00")
#     #     # id    = "0000:01:00"
#     #
#     #     pcie    = true
#     #     rombar  = true
#     #     xvga    = false                       # Set true if primary display
#     #   }
#     # ]
#   }
# }

# ----------------------------------------------------------------
# Optional Global Infrastructure Settings
# ----------------------------------------------------------------

# Cloud-Init Image & Snippets
# ubuntu_cloud_image_url      = "https://cloud-images.ubuntu.com/releases/26.04/release/ubuntu-26.04-server-cloudimg-amd64.img"
# ubuntu_cloud_image_filename = "ubuntu-26.04-server-cloudimg-amd64.img"
# image_datastore_id          = "local"
# enable_cloudinit_snippet    = true              # Automatically installs and starts qemu-guest-agent via snippet
# snippet_datastore_id        = "local"           # Datastore where snippets are stored (must support 'snippets')

# Cloud-Init User & DNS
# vm_user     = "ubuntu"
# dns_servers = ["9.9.9.9", "1.1.1.1"]
# dns_domain  = "."                               # '.' represents no search domain in Proxmox
